<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <meta name="robots" content="index, follow">
  <link rel="service-desc" href="/openapi.json" type="application/json" title="AI Shop OpenAPI Spec">

  <!-- Canonical -->
  <% if (typeof product !== 'undefined' && product) { %>
  <link rel="canonical" href="<%= baseUrl %>/product/<%= product.slug %>">
  <% } else if (typeof currentCategory !== 'undefined' && currentCategory) { %>
  <link rel="canonical" href="<%= baseUrl %>/catalog/<%= currentCategory.slug %>">
  <% } else { %>
  <link rel="canonical" href="<%= baseUrl %>">
  <% } %>

  <link rel="stylesheet" href="/css/styles.css">
  <link rel="preconnect" href="https://images.unsplash.com">
</head>
