<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <meta name="robots" content="index, follow">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:site_name" content="AI Shop">
  <% if (typeof product !== 'undefined' && product) { %>
  <meta property="og:image" content="<%= product.image_url %>">
  <meta property="og:url" content="<%= baseUrl %>/product/<%= product.slug %>">
  <% } else { %>
  <meta property="og:url" content="<%= baseUrl %>">
  <% } %>

  <!-- Canonical -->
  <% if (typeof product !== 'undefined' && product) { %>
  <link rel="canonical" href="<%= baseUrl %>/product/<%= product.slug %>">
  <% } else if (typeof currentCategory !== 'undefined' && currentCategory) { %>
  <link rel="canonical" href="<%= baseUrl %>/catalog/<%= currentCategory.slug %>">
  <% } else { %>
  <link rel="canonical" href="<%= baseUrl %>">
  <% } %>

  <!-- JSON-LD for AI + search engines -->
  <% if (typeof product !== 'undefined' && product) {
    var _attrs = (product.attributes && typeof product.attributes === 'object') ? product.attributes : {};
    var _addlProps = [];
    Object.entries(_attrs).forEach(function(pair) {
      var k = pair[0], v = pair[1];
      (Array.isArray(v) ? v : [v]).forEach(function(val) {
        _addlProps.push({ '@type': 'PropertyValue', name: k, value: String(val) });
      });
    });
    var _ld = {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: product.name,
      description: product.short_description || '',
      image: product.image_url,
      sku: product.sku || '',
      category: product.category_name || '',
      brand: { '@type': 'Brand', name: product.brand || '' },
      offers: {
        '@type': 'Offer',
        url: baseUrl + '/product/' + product.slug,
        priceCurrency: 'USD',
        price: String(product.price),
        availability: product.in_stock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
        itemCondition: 'https://schema.org/NewCondition'
      }
    };
    if (product.tags && product.tags.length) _ld.keywords = product.tags.join(', ');
    if (_addlProps.length) _ld.additionalProperty = _addlProps;
    if (product.review_count > 0) {
      _ld.aggregateRating = {
        '@type': 'AggregateRating',
        ratingValue: String(product.rating),
        reviewCount: product.review_count,
        bestRating: '5',
        worstRating: '1'
      };
    }
  %>
  <script type="application/ld+json"><%- JSON.stringify(_ld) %></script>
  <% } %>

  <link rel="stylesheet" href="/css/styles.css">
  <link rel="preconnect" href="https://images.unsplash.com">
</head>
