<article class="product-card">
  <a href="/product/<%= product.slug %>" class="product-card-image-link">
    <div class="product-card-image-wrap">
      <img src="<%= product.image_url %>"
           alt="<%= product.name %>"
           loading="lazy"
           width="300" height="300"
           onerror="this.src='/images/placeholder.svg'">
      <% if (product.is_new) { %><span class="badge badge-new">New</span><% } %>
      <% if (product.compare_at_price && parseFloat(product.compare_at_price) > parseFloat(product.price)) { %>
        <span class="badge badge-sale">
          -<%= Math.round((1 - parseFloat(product.price)/parseFloat(product.compare_at_price))*100) %>%
        </span>
      <% } %>
    </div>
  </a>
  <div class="product-card-body">
    <div class="product-card-meta">
      <span class="product-brand"><%= product.brand %></span>
      <span class="product-category"><%= product.category_name %></span>
    </div>
    <h3 class="product-name">
      <a href="/product/<%= product.slug %>"><%= product.name %></a>
    </h3>
    <p class="product-short-desc"><%= product.short_description %></p>
    <div class="product-card-footer">
      <div class="product-price-group">
        <span class="product-price">$<%= parseFloat(product.price).toFixed(2) %></span>
        <% if (product.compare_at_price && parseFloat(product.compare_at_price) > parseFloat(product.price)) { %>
        <span class="product-compare-price">$<%= parseFloat(product.compare_at_price).toFixed(2) %></span>
        <% } %>
      </div>
      <div class="product-rating">
        <span class="stars">★</span>
        <span class="rating-value"><%= parseFloat(product.rating).toFixed(1) %></span>
        <span class="review-count">(<%= product.review_count.toLocaleString() %>)</span>
      </div>
    </div>
    <a href="/product/<%= product.slug %>" class="btn btn-outline product-card-btn">View Details</a>
  </div>
</article>
