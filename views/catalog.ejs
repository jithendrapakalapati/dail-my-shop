<%- include('partials/head', { title, description, baseUrl, product: null, currentCategory: typeof currentCategory !== 'undefined' ? currentCategory : null }) %>
<body>
<%- include('partials/header', { categories, searchQuery: typeof searchQuery !== 'undefined' ? searchQuery : (filters.q || '') }) %>

<main class="catalog-page">
  <div class="container catalog-layout">

    <!-- Sidebar filters -->
    <aside class="catalog-sidebar" id="catalogSidebar">
      <div class="sidebar-header">
        <h2>Filters</h2>
        <button class="btn-icon sidebar-close" id="sidebarClose" aria-label="Close filters">✕</button>
      </div>

      <form action="<%= currentCategory ? '/catalog/' + currentCategory.slug : '/catalog' %>" method="get" id="filterForm">

        <!-- Search -->
        <div class="filter-group">
          <label class="filter-label" for="filterQ">Search</label>
          <input type="search" name="q" id="filterQ" value="<%= filters.q || '' %>"
                 placeholder="Search products…" class="filter-input">
        </div>

        <!-- Categories -->
        <div class="filter-group">
          <h3 class="filter-label">Category</h3>
          <ul class="filter-list">
            <li>
              <a href="/catalog" class="filter-option <%= !currentCategory ? 'active' : '' %>">
                All Products
              </a>
            </li>
            <% categories.forEach(cat => { %>
            <li>
              <a href="/catalog/<%= cat.slug %>"
                 class="filter-option <%= currentCategory && currentCategory.slug === cat.slug ? 'active' : '' %>">
                <span><%= cat.icon %> <%= cat.name %></span>
                <span class="filter-count"><%= cat.product_count %></span>
              </a>
            </li>
            <% }) %>
          </ul>
        </div>

        <!-- Price range -->
        <div class="filter-group">
          <h3 class="filter-label">Price Range</h3>
          <div class="price-inputs">
            <input type="number" name="min_price" placeholder="Min $"
                   value="<%= filters.min_price || '' %>" min="0" class="filter-input price-input">
            <span>–</span>
            <input type="number" name="max_price" placeholder="Max $"
                   value="<%= filters.max_price || '' %>" min="0" class="filter-input price-input">
          </div>
        </div>

        <!-- Brand -->
        <% if (brands.length > 0) { %>
        <div class="filter-group">
          <h3 class="filter-label">Brand</h3>
          <select name="brand" class="filter-select">
            <option value="">All Brands</option>
            <% brands.forEach(b => { %>
            <option value="<%= b %>" <%= filters.brand === b ? 'selected' : '' %>><%= b %></option>
            <% }) %>
          </select>
        </div>
        <% } %>

        <!-- In stock -->
        <div class="filter-group">
          <label class="filter-checkbox">
            <input type="checkbox" name="in_stock" value="true" <%= filters.in_stock === 'true' ? 'checked' : '' %>>
            <span>In Stock Only</span>
          </label>
        </div>

        <!-- Sort (hidden on desktop, shown on mobile) -->
        <input type="hidden" name="sort" id="sortHidden" value="<%= filters.sort || '' %>">

        <button type="submit" class="btn btn-primary filter-submit">Apply Filters</button>
        <a href="<%= currentCategory ? '/catalog/' + currentCategory.slug : '/catalog' %>" class="btn btn-ghost filter-reset">Reset</a>
      </form>
    </aside>

    <!-- Main content -->
    <div class="catalog-main">

      <!-- Top bar -->
      <div class="catalog-topbar">
        <div class="catalog-breadcrumb">
          <a href="/">Home</a>
          <span>›</span>
          <% if (currentCategory) { %>
          <a href="/catalog">All Products</a>
          <span>›</span>
          <span><%= currentCategory.icon %> <%= currentCategory.name %></span>
          <% } else if (filters.q) { %>
          <span>Search: "<%= filters.q %>"</span>
          <% } else { %>
          <span>All Products</span>
          <% } %>
        </div>
        <div class="catalog-controls">
          <span class="result-count"><%= pagination.total %> product<%= pagination.total !== 1 ? 's' : '' %></span>
          <select class="sort-select" id="sortSelect">
            <option value="" <%= !filters.sort ? 'selected' : '' %>>Featured</option>
            <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest</option>
            <option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>>Price: Low–High</option>
            <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Price: High–Low</option>
            <option value="rating" <%= filters.sort === 'rating' ? 'selected' : '' %>>Best Rated</option>
            <option value="name_asc" <%= filters.sort === 'name_asc' ? 'selected' : '' %>>A–Z</option>
          </select>
          <button class="btn btn-outline filter-toggle-btn" id="filterToggle">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
            Filters
          </button>
        </div>
      </div>

      <!-- Active filters chips -->
      <% const hasFilters = filters.brand || filters.min_price || filters.max_price || filters.in_stock || filters.q; %>
      <% if (hasFilters) { %>
      <div class="active-filters">
        <% if (filters.q) { %>
        <span class="filter-chip">Search: "<%= filters.q %>" <a href="?">✕</a></span>
        <% } %>
        <% if (filters.brand) { %>
        <span class="filter-chip">Brand: <%= filters.brand %></span>
        <% } %>
        <% if (filters.min_price) { %>
        <span class="filter-chip">Min: $<%= filters.min_price %></span>
        <% } %>
        <% if (filters.max_price) { %>
        <span class="filter-chip">Max: $<%= filters.max_price %></span>
        <% } %>
        <% if (filters.in_stock) { %>
        <span class="filter-chip">In Stock</span>
        <% } %>
        <a href="<%= currentCategory ? '/catalog/' + currentCategory.slug : '/catalog' %>" class="filter-chip filter-chip-clear">Clear all</a>
      </div>
      <% } %>

      <!-- Product grid -->
      <% if (products.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">🔍</div>
        <h3>No products found</h3>
        <p>Try adjusting your filters or <a href="/catalog">browse everything</a>.</p>
      </div>
      <% } else { %>
      <div class="products-grid" id="productGrid">
        <% products.forEach(product => { %>
          <%- include('partials/product-card', { product }) %>
        <% }) %>
      </div>
      <% } %>

      <!-- Pagination -->
      <% if (pagination.totalPages > 1) { %>
      <nav class="pagination" aria-label="Pagination">
        <% if (pagination.page > 1) { %>
        <a href="?<%= new URLSearchParams({...filters, page: pagination.page - 1}).toString() %>" class="page-btn">← Prev</a>
        <% } %>

        <% for (let i = Math.max(1, pagination.page - 2); i <= Math.min(pagination.totalPages, pagination.page + 2); i++) { %>
        <a href="?<%= new URLSearchParams({...filters, page: i}).toString() %>"
           class="page-btn <%= i === pagination.page ? 'active' : '' %>"><%= i %></a>
        <% } %>

        <% if (pagination.page < pagination.totalPages) { %>
        <a href="?<%= new URLSearchParams({...filters, page: pagination.page + 1}).toString() %>" class="page-btn">Next →</a>
        <% } %>
      </nav>
      <% } %>
    </div>
  </div>
</main>

<!-- Mobile sidebar overlay -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<%- include('partials/footer') %>
</body>
</html>
